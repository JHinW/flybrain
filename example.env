# FlyBrain AI Caretaker Configuration
# Copy this file to .env and configure as needed: cp example.env .env

# ==============================================================================
# 1. Standard Anthropic API Configuration
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ==============================================================================
# 2. Custom Anthropic-Compatible AI Endpoint Configuration
# ==============================================================================
# Base URL of your Anthropic-compatible gateway, proxy, or server.
# Supported formats:
#   http://localhost:8000
#   http://localhost:8000/v1
#   https://api.your-proxy.com
#   https://api.your-proxy.com/v1
#   https://openrouter.ai/api/v1
# (Trailing /v1 and /v1/messages will be automatically normalized)
#
# ANTHROPIC_BASE_URL=https://api.your-proxy.com
# ANTHROPIC_API_KEY=your-custom-api-key

# Optional: Bearer authentication token if your endpoint expects Bearer tokens
# ANTHROPIC_AUTH_TOKEN=your-bearer-token

# Optional: Custom headers as a JSON string or comma-separated pairs
# ANTHROPIC_CUSTOM_HEADERS={"HTTP-Referer": "https://flybrain.local", "X-Title": "FlyBrain"}
# ANTHROPIC_CUSTOM_HEADERS=HTTP-Referer=https://flybrain.local,X-Title=FlyBrain

# ==============================================================================
# 3. Model Configuration
# ==============================================================================
# General model for both chat and decision loop (if not overridden below)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Model used specifically by the Caretaker Chat endpoint (/chat)
# Default: claude-sonnet-4-20250514
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# Model used specifically by the Caretaker autonomous decision loop
# Default: claude-3-5-haiku-20241022
# ANTHROPIC_AGENT_MODEL=claude-3-5-haiku-20241022

# ==============================================================================
# 4. Server Configuration
# ==============================================================================
# CARETAKER_PORT=7600
# USE_CLAUDE_CLI=false
